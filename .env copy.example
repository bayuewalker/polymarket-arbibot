# Polymarket Arbitrage Bot Environment Variables Example
# Copy this file to .env and modify with actual values

# Bot Settings
MIN_PROFIT_MARGIN=0.01          # Minimum profit margin (1% = 0.01)
SCAN_INTERVAL=1.0                # Market scan interval (seconds)
MAX_MARKETS_TO_MONITOR=100       # Maximum number of markets to monitor simultaneously

# Web3 Settings (only required for actual trading)
PRIVATE_KEY=                     # Wallet private key (only set when actually trading)
POLYGON_RPC_URL=https://polygon-rpc.com

# Data Logger Settings
ENABLE_DATA_LOGGING=true         # Enable data logging
LOG_DIR=./logs                   # Log file storage directory

# Trading Settings
MIN_TRADE_SIZE=0.01              # Minimum trade amount
MAX_SLIPPAGE=0.01                # Maximum slippage (1% = 0.01)

# Paper Trading (simulate trades without real funds)
PAPER_TRADING=true               # true = paper mode, false = live trading
PAPER_BALANCE=1000.0             # Starting virtual USDC balance
PAPER_TRADE_SIZE=10.0            # Virtual trade size per opportunity (USDC)

# Strategy 5: Long-Shot Floor Buying (optional)
ENABLE_STRATEGY_5=false
STRATEGY_5_MAX_PRICE=0.001
STRATEGY_5_BET_SIZE=0.01
STRATEGY_5_MAX_MARKETS=1000
STRATEGY_5_MIN_PROBABILITY=0.0001

# Telegram Bot Control (required for main.py)
TELEGRAM_BOT_TOKEN=              # From @BotFather on Telegram
TELEGRAM_CHAT_ID=                # Your numeric chat ID (get from @userinfobot)
BOT_AUTO_START=false             # true = scanning starts automatically on launch
STATS_INTERVAL_HOURS=1.0         # How often to send periodic stats (hours)
